{layout '../@layout.latte'}

{block #content}

<div class="c-header">
    <h2>Newsletter lists</h2>
</div>
<div class="card">
    <div class="card-header">
        <h2 n:block="title">Edit newsletter list <small></small></h2>
        <div class="actions">
            <a n:href="Show $list->id">
                <button type="button" class="btn palette-Cyan bg waves-effect"><i class="zmdi zmdi-eye"></i> View</button>
            </a>
        </div>
    </div>
    <div class="card-body card-padding">
        {snippetArea wrapper}
            {include @form.latte}
        {/snippetArea}
    </div>
</div>
